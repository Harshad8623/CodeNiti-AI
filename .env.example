# CodeNiti AI Environment Configuration
# Copy this file to .env and fill in your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
APP_ENV=development
PORT=8000
ENABLE_SIGNUP=true
AI_DAILY_LIMIT=30
RATE_LIMIT_PER_MINUTE=20
CACHE_TTL_SECONDS=86400
AI_TIMEOUT_SECONDS=50
# Set DATABASE_PATH if mounting a persistent volume on cloud providers
# DATABASE_PATH=/data/codeniti.db
